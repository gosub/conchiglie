# .bashrc for gg

# Emacs is my editor <3
export EDITOR=emacs

# VCV Rack SDK directory
export RACK_DIR=~/dl/audio/rack-sdk

# Force Firefox to use Wayland
export MOZ_ENABLE_WAYLAND=1

# XDG base directories (explicit, so tools can rely on them)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
# XDG_DATA_HOME left unset on purpose: some apps misbehave when it is set
data_dir="$HOME/.local/share"  # not exported, only used below
export XDG_STATE_HOME="$HOME/.local/state"

# Go: keep ~/go out of the home root
export GOPATH="$data_dir/go"
export GOMODCACHE="$XDG_CACHE_HOME/go/mod"
export GOBIN="$HOME/.local/bin"

# Rust: keep ~/.cargo and ~/.rustup out of the home root
export CARGO_HOME="$data_dir/cargo"
export RUSTUP_HOME="$data_dir/rustup"
export CARGO_INSTALL_ROOT="$HOME/.local"  # cargo install -> ~/.local/bin

# npm: cache (and logs, npx) out of ~/.npm
export npm_config_cache="$XDG_CACHE_HOME/npm"

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# use colors for ls
alias ls='ls --color=auto'

# use colors for grep
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'

# simple prompt
PS1='[\u@\h \W]\$ '

# change default autocompletion style
bind 'set show-all-if-ambiguous on'
bind 'set menu-complete-display-prefix on'
bind 'TAB:menu-complete'

# create local shell folter if it doesnt exist
mkdir -p ~/.local/shell

# put less history in a better place
export LESSHISTFILE=~/.local/shell/.lesshst

# put bash history in a better place
HISTFILE=~/.local/shell/.bash_history

# put python and sqlite REPL histories in the same place
export PYTHON_HISTORY=~/.local/shell/.python_history
export SQLITE_HISTORY=~/.local/shell/.sqlite_history

# don't put duplicate lines or lines starting with space in the history.
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=10000
HISTFILESIZE=50000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# gg personal aliases and functions in 'utilitarie'
if [ -f ~/.config/bash/utilitarie ]; then
    . ~/.config/bash/utilitarie
fi
